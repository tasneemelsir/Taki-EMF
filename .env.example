# Taki settings. Copy this file to ".env" and edit it. Every line is optional:
# with no .env at all, Taki runs on one computer and keeps its data in ./data.

# --- Online database --------------------------------------------------------
# Easiest: run "python run.py setup-db" (or connect-database.bat / .sh). It asks
# for the connection string, tests it, and writes this line for you.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# TAKI_DB_POOL=5                 # connections kept open (free plans allow few)

# --- Local data (used when no DATABASE_URL is set) --------------------------
# TAKI_DATA_DIR=./data

# --- Publishing Taki as a website -------------------------------------------
# TAKI_HOST=0.0.0.0              # listen on every interface (server or container)
# TAKI_PORT=8000
# TAKI_PUBLIC_URL=https://taki.example.org   # the address people open
# TAKI_SECURE_COOKIES=1          # only send the session cookie over HTTPS
# TAKI_WORKERS=2                 # server processes
# TAKI_TRUSTED_PROXIES=127.0.0.1 # the reverse proxy in front of Taki ("*" on a managed host)
# TAKI_ALLOW_SIGNUP=1            # 0 = no new accounts
# TAKI_ALLOW_GUESTS=1            # 0 = no "continue as a guest"
# TAKI_SESSION_DAYS=30
# TAKI_DESKTOP_DOWNLOAD=1        # 0 = do not hand out the desktop version from this copy

# --- Email for "forgot password" (optional) ---------------------------------
# Without it, reset links are printed in the server window instead of emailed.
# Needs TAKI_PUBLIC_URL above. Any SMTP service works (Gmail app password, Brevo, ...).
# TAKI_SMTP_HOST=smtp.gmail.com
# TAKI_SMTP_PORT=587
# TAKI_SMTP_USER=you@example.com
# TAKI_SMTP_PASSWORD=
# TAKI_SMTP_FROM=Taki <you@example.com>
# TAKI_SMTP_SECURITY=starttls    # starttls | ssl | none

# --- AI narrative in reports (optional) -------------------------------------
# You do not need any of this. Each person enters their own key for Claude,
# Gemini or ChatGPT in the app, and it stays in their browser.
#
# Set one of these ONLY if you want this copy of Taki to pay for everyone's
# narratives with YOUR key. It is then used for signed-in accounts (not guests)
# that have not entered a key of their own, a few times an hour each.
# Only these TAKI_ names are read: a key your computer has for another program
# (ANTHROPIC_API_KEY, OPENAI_API_KEY ...) is never used.
# TAKI_ANTHROPIC_API_KEY=
# TAKI_GEMINI_API_KEY=
# TAKI_OPENAI_API_KEY=
# TAKI_AI_PER_HOUR=10            # narratives per account per hour on a shared key
